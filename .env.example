# Copy to .env and adjust. .env is gitignored; never commit real secrets.
# Spring Boot does not read .env files itself: export these in your shell
# (or set them in your IDE run configuration) before starting the backend.
# All backend values below are optional locally; the defaults in
# backend/src/main/resources/application-local.yml match these examples.

# ---- Database (used by docker-compose.yml AND the backend) ----
# Database name created by the Postgres container (compose only)
DB_NAME=wassel
DB_USERNAME=wassel
DB_PASSWORD=wassel
# JDBC URL the backend connects with; host/port/db must match the container
DB_URL=jdbc:postgresql://localhost:5432/wassel

# ---- Backend: JWT ----
# Placeholder only. Generate a real one with: openssl rand -base64 48
# Must be long (>= 32 bytes) and MUST be overridden in every deployed environment.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
# Token lifetime (local profile default 24h, base default 1h)
JWT_EXPIRATION=24h

# ---- Frontend (Next.js) ----
# Put these in frontend/.env.local (gitignored). Only NEXT_PUBLIC_* vars are exposed to the browser.
# Base URL of the backend API when running locally (Spring Boot default port 8080).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
