# Copy to .env.staging and fill in real values. .env.staging is gitignored;
# never commit it. Unlike .env.example, do NOT reuse these placeholder values —
# staging should use its own generated credentials, distinct from local dev.

# ---- Database ----
DB_NAME=wassel
DB_USERNAME=wassel
DB_PASSWORD=change-me-generate-a-real-password

# ---- Backend: JWT ----
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
JWT_EXPIRATION=1h
JWT_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Backend: first admin account (set both, password >= 10 characters) ----
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# ---- Backend: password links ----
# The staging frontend's address; set-password and reset links point here.
FRONTEND_BASE_URL=http://localhost:3000

# ---- Backend: email ----
# Staging sends real email (login codes, set-password and reset links); it is not printed in the logs.
# Gmail: turn on 2-Step Verification for the account, then create an app password at
# myaccount.google.com/apppasswords and paste it here (not the account's normal password). Gmail sends
# as this account whatever the "from" says. Gmail ignores dots and "+tags", so you@gmail.com,
# you+driver@gmail.com and you+parent@gmail.com all reach one inbox: handy for test accounts.
MAIL_USERNAME=change-me@gmail.com
MAIL_PASSWORD=change-me-16-character-app-password
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587

# ---- Backend: school location (routing contract) ----
# Where every route ends. The MVP serves one school, so this is a config value, not a
# school setting; the backend refuses to start without it.
SCHOOL_LATITUDE=33.896
SCHOOL_LONGITUDE=35.484

# ---- Logs (Grafana) ----
# Password for the Grafana admin account, which is where the centralized logs are viewed.
# Set a real one; Docker Compose refuses to start Grafana without it.
GRAFANA_ADMIN_PASSWORD=change-me-generate-a-real-password

# ---- Frontend (Next.js) ----
# Where the browser sends API calls. Baked into the frontend image at build time (see
# frontend/Dockerfile), so changing it or BACKEND_URL requires rebuilding the frontend container.
# - Empty (the default, and how a real deployment runs): the browser calls the app's own origin and
#   the app proxies /api/* to BACKEND_URL, so the session cookie works from one site. The backend's
#   CORS_ALLOWED_ORIGINS must still list the address you open the app at (see README, "One site for
#   the app and its API").
# - A URL such as http://localhost:8080: the browser calls the backend directly instead.
NEXT_PUBLIC_API_BASE_URL=
# Where the app's server reaches the backend when proxying (used only when the line above is empty).
# Inside this compose stack the backend is "backend"; on a real deployment it is the backend's public URL.
BACKEND_URL=http://backend:8080
